# Reference values only. Spring Boot does not load .env files automatically;
# export these variables in the service environment or shell before startup.
SERVER_PORT=8080
MEDIA_PROVIDER=unavailable
YTDLP_EXECUTABLE=yt-dlp
YTDLP_TIMEOUT_SECONDS=30
YTDLP_DOWNLOAD_TIMEOUT_SECONDS=120
YTDLP_MAX_DOWNLOAD_BYTES=52428800
# Local Vite development only; for same-origin production leave this empty.
REELSAVE_CORS_ALLOWED_ORIGINS=http://localhost:5173
REELSAVE_RATE_LIMIT_ENABLED=true
REELSAVE_RATE_LIMIT_REQUESTS_PER_WINDOW=30
REELSAVE_RATE_LIMIT_WINDOW_SECONDS=60
REELSAVE_RATE_LIMIT_MAX_CLIENTS=10000
REELSAVE_LOGGING_LEVEL_ROOT=INFO
