# Leave blank for same-origin /api routes in production.
# Local Vite development proxies /api to VITE_DEV_API_PROXY_TARGET instead.
VITE_API_BASE_URL=
VITE_DEV_API_PROXY_TARGET=http://localhost:8080
VITE_PUBLIC_SITE_URL=
VITE_CONTACT_EMAIL=
# Must match backend YTDLP_MAX_DOWNLOAD_BYTES; values above 50 MiB use the hard cap.
VITE_DOWNLOAD_MAX_BYTES=52428800
